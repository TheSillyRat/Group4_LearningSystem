@model IEnumerable<LMS.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>User Management</h2>
            <p class="text-muted small mb-0">Manage system users, accounts, and access roles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-3">
            <i class="bi bi-person-plus-fill me-1"></i>Create New User
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control border-start-0" placeholder="Search by name or email..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="roleId" class="form-select" asp-items="ViewBag.Roles">
                        <option value="0">-- All Roles --</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 rounded-3">Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 rounded-3">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Role</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var roleName = user.Role?.RoleName ?? "Student";
                        var badgeClass = roleName switch {
                            "Admin" => "bg-danger",
                            "Instructor" => "bg-warning text-dark",
                            _ => "bg-info text-dark"
                        };

                        <tr>
                            <td class="ps-3 fw-bold">#@user.UserId</td>
                            <td class="fw-semibold">@user.FullName</td>
                            <td class="text-muted">@user.Email</td>
                            <td><span class="badge @badgeClass fs-6 px-2 py-1">@roleName</span></td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary rounded-2">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-2">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
