@model LMS.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid py-3" style="max-width: 600px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary small">&larr; Back to User List</a>
        <h3 class="fw-bold mt-2"><i class="bi bi-pencil-square text-primary me-2"></i>Edit User Account</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-medium">Full Name</label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-medium">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RoleId" class="form-label fw-medium">Role</label>
                    <select asp-for="RoleId" class="form-select" asp-items="ViewBag.Roles" required></select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-medium">Primary Password (Leave blank to keep unchanged)</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="New password..." />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="SecurityPassword" class="form-label fw-medium">Secondary Security Password</label>
                    <input asp-for="SecurityPassword" type="password" class="form-control" placeholder="New security password..." />
                    <span asp-validation-for="SecurityPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
