@model IEnumerable<LMS.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollment Management";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-person-check-fill text-primary me-2"></i>Enrollment Management</h2>
            <p class="text-muted small mb-0">Overview and subscription management for student course enrollments.</p>
        </div>
        <button type="button" class="btn btn-primary rounded-3" data-bs-toggle="modal" data-bs-target="#enrollModal">
            <i class="bi bi-plus-lg me-1"></i>Enroll Student to Course
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 small mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Student Name</th>
                        <th>Course Title</th>
                        <th>Enrollment Date</th>
                        <th>Progress</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">#@item.EnrollmentId</td>
                            <td class="fw-semibold">@(item.Student?.FullName ?? "Student")</td>
                            <td class="text-primary fw-medium">@(item.Course?.CourseName ?? "Course")</td>
                            <td class="small text-muted">@item.EnrollmentDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2" style="max-width: 150px;">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @(item.Progress ?? 0)%"></div>
                                    </div>
                                    <span class="small fw-bold text-success">@(item.Progress ?? 0)%</span>
                                </div>
                            </td>
                            <td class="text-end pe-3">
                                <form asp-action="Delete" asp-route-id="@item.EnrollmentId" method="post" onsubmit="return confirm('Are you sure you want to remove this enrollment?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-2">
                                        <i class="bi bi-trash me-1"></i>Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Enroll Student -->
<div class="modal fade" id="enrollModal" tabindex="-1" aria-labelledby="enrollModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="enrollModalLabel"><i class="bi bi-person-plus me-2 text-primary"></i>Enroll Student to Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Select Student</label>
                        <select name="studentId" class="form-select" asp-items="ViewBag.Students" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Select Course</label>
                        <select name="courseId" class="form-select" asp-items="ViewBag.Courses" required></select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3">Enroll Student</button>
                </div>
            </form>
        </div>
    </div>
</div>
