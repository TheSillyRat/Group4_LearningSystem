@model LMS.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container-fluid py-3">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <a asp-action="Index" class="text-decoration-none text-secondary small">&larr; Back to Course List</a>
            <h2 class="fw-bold mt-1 text-primary"><i class="bi bi-book me-2"></i>@Model.CourseName</h2>
        </div>
        <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-primary rounded-3">
            <i class="bi bi-pencil me-1"></i>Edit Course
        </a>
    </div>

    <div class="row g-4">
        <!-- Overview Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 mb-3">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Course Overview</h5>
                    <p><strong>Instructor:</strong> @(Model.Instructor?.FullName ?? "Unassigned")</p>
                    <p><strong>Email:</strong> @(Model.Instructor?.Email ?? "N/A")</p>
                    <p><strong>Prerequisites:</strong> @(string.IsNullOrEmpty(Model.Prerequisite) ? "None" : Model.Prerequisite)</p>
                    <p><strong>Materials:</strong> @(string.IsNullOrEmpty(Model.Materials) ? "None" : Model.Materials)</p>
                    <p class="text-muted small">@Model.Description</p>
                </div>
            </div>
        </div>

        <!-- Modules & Enrolled Students -->
        <div class="col-lg-8">
            <!-- Modules -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-text me-2 text-primary"></i>Course Modules</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Modules != null && Model.Modules.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var mod in Model.Modules)
                            {
                                <li class="list-group-item p-3">
                                    <div class="fw-bold">@mod.ModuleName</div>
                                    <div class="text-muted small mb-2">@mod.Description</div>
                                    @if (mod.Contents != null && mod.Contents.Any())
                                    {
                                        <div class="ps-3 border-start">
                                            @foreach (var cnt in mod.Contents)
                                            {
                                                <div class="small text-secondary"><i class="bi bi-file-earmark-text me-1"></i>@cnt.Title (@cnt.ContentType)</div>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-3 text-muted">No modules created for this course yet.</div>
                    }
                </div>
            </div>

            <!-- Enrolled Students -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people me-2 text-success"></i>Enrolled Students</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Enrollments != null && Model.Enrollments.Any())
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Student Name</th>
                                    <th>Email</th>
                                    <th>Enrollment Date</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var enr in Model.Enrollments)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@(enr.Student?.FullName ?? "Student")</td>
                                        <td class="text-muted small">@(enr.Student?.Email ?? "N/A")</td>
                                        <td class="small">@enr.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                        <td><span class="badge bg-success">@(enr.Progress ?? 0)%</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="p-3 text-muted">No students currently enrolled in this course.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
