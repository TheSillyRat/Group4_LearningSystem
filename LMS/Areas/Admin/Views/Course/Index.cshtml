@model IEnumerable<LMS.Models.Course>

@{
    ViewData["Title"] = "Course Management";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Course Management</h2>
            <p class="text-muted small mb-0">Overview of all active courses, instructors, and enrolled students.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-3">
            <i class="bi bi-plus-lg me-1"></i>Create New Course
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Course Title</th>
                        <th>Instructor</th>
                        <th>Prerequisites</th>
                        <th>Students Enrolled</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        var studentCount = course.Enrollments?.Count ?? 0;
                        <tr>
                            <td class="ps-3 fw-bold">#@course.CourseId</td>
                            <td class="fw-semibold text-primary">@course.CourseName</td>
                            <td>@(course.Instructor?.FullName ?? "Unassigned")</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(course.Prerequisite) ? "None" : course.Prerequisite)</td>
                            <td><span class="badge bg-info text-dark">@studentCount Students</span></td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-info rounded-2">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-primary rounded-2">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@course.CourseId" method="post" onsubmit="return confirm('Are you sure you want to delete this course?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-2">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
