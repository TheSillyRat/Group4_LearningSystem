@model LMS.Models.Course

@{
    ViewData["Title"] = "Create New Course";
}

<div class="container-fluid py-3" style="max-width: 650px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary small">&larr; Back to Course List</a>
        <h3 class="fw-bold mt-2"><i class="bi bi-journal-plus text-primary me-2"></i>Create New Course</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="CourseName" class="form-label fw-medium">Course Title</label>
                    <input asp-for="CourseName" class="form-control" placeholder="e.g. C# & ASP.NET Core Development" required />
                    <span asp-validation-for="CourseName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="InstructorId" class="form-label fw-medium">Assigned Instructor</label>
                    <select asp-for="InstructorId" class="form-select" asp-items="ViewBag.Instructors" required></select>
                    <span asp-validation-for="InstructorId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Prerequisite" class="form-label fw-medium">Prerequisites</label>
                    <input asp-for="Prerequisite" class="form-control" placeholder="e.g. Basic C# knowledge" />
                    <span asp-validation-for="Prerequisite" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Materials" class="form-label fw-medium">Materials & Resources</label>
                    <input asp-for="Materials" class="form-control" placeholder="e.g. Slide slides, source code" />
                    <span asp-validation-for="Materials" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-medium">Course Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Brief course description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 rounded-3">Create Course</button>
                </div>
            </form>
        </div>
    </div>
</div>
