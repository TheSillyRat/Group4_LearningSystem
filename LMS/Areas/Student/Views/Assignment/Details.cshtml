@model LMS.Models.Assignment
@{
    ViewData["Title"] = "Submit Assignment";
}

<style>
    .submit-container {
        max-width: 900px;
        margin: 2rem auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        padding: 40px;
    }

    .course-badge {
        background-color: #e0e7ff;
        color: #4338ca;
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-block;
        margin-bottom: 16px;
    }

    .assignment-header {
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .submission-area {
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 24px;
    }

    .custom-textarea {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 12px;
        min-height: 150px;
        resize: vertical;
    }
</style>

<div class="submit-container">
    <div class="assignment-header">
        <span class="course-badge">Course: UX/UI Design - Module 1</span>
        <h2 class="fw-bold mb-3">@Model.AssignmentTitle</h2>

        <div class="d-flex gap-4 text-muted mb-3">
            <span><i class="bi bi-calendar-x"></i> Due: @Model.DueDate.ToString("MMM dd, yyyy HH:mm")</span>
            <span><i class="bi bi-award"></i> Max Score: 100</span>
        </div>

        <p class="text-dark">@Model.Description</p>

        @if (!string.IsNullOrEmpty(Model.AttachmentUrl))
        {
            <a href="@Model.AttachmentUrl" class="btn btn-outline-secondary btn-sm mt-2" download>
                <i class="bi bi-download"></i> Download Assignment Material
            </a>
        }
    </div>

    <div class="submission-area">
        <h5 class="fw-bold mb-4">Your Submission</h5>

        <form asp-action="SubmitAssignment" asp-controller="Assignment" asp-area="Student" method="post" enctype="multipart/form-data">
            <input type="hidden" name="AssignmentId" value="@Model.AssignmentId" />

            <div class="mb-4">
                <label class="fw-semibold mb-2">Additional Comments / Description</label>
                <textarea name="StudentNotes" class="custom-textarea" placeholder="Type your answer or notes here..."></textarea>
            </div>

            <div class="mb-4">
                <label class="fw-semibold mb-2">Upload File</label>
                <input type="file" name="SubmittedFile" class="form-control" required />
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary px-5 py-2 fw-bold">Submit Assignment</button>
            </div>
        </form>
    </div>
</div>