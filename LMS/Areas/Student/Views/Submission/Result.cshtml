@model LMS.Models.Submission

@{
    ViewData["Title"] = "Grade Result";
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 600px; border-radius: 16px; border: none;">
        <div class="card-body p-5 text-center">
            <h3 class="fw-bold mb-2">Grade Result</h3>
            <h5 class="text-secondary mb-4">@Model.Assignment?.AssignmentTitle</h5>

            <div class="display-3 fw-bold text-success mb-4">
                @Model.Score / 100
            </div>

            <div class="text-start bg-light p-4 rounded-3 mb-4">
                <p class="fw-bold mb-2 text-dark"><i class="bi bi-chat-square-text"></i> Instructor Feedback:</p>
                <p class="mb-0 text-secondary" style="font-size: 0.95rem;">
                    @(string.IsNullOrEmpty(Model.Feedback) ? "No feedback provided." : Model.Feedback)
                </p>
            </div>

            <a asp-action="MyAssignments" class="btn btn-outline-primary px-5 py-2 rounded-pill fw-bold">Back to Dashboard</a>
        </div>
    </div>
</div>