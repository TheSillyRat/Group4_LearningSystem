@model IEnumerable<LMS.Models.Course>

@{
    ViewData["Title"] = "Browse Available Courses";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>🔍 Browse Courses</h2>
        <p class="text-muted mb-3">Explore new courses available for enrollment</p>

        <!-- SEARCH BAR AND INSTRUCTOR FILTER FORM -->
        <form method="get" asp-action="Browse" class="row g-2 align-items-center bg-light p-3 rounded-3 shadow-sm border">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">🔍</span>
                    <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" class="form-control border-start-0" placeholder="Search course by name..." />
                </div>
            </div>

            <div class="col-md-4">
                <select name="instructorId" class="form-select">
                    <option value="">-- Filter by Instructor --</option>
                    @if (ViewBag.Instructors != null)
                    {
                        foreach (var inst in (List<LMS.Models.User>)ViewBag.Instructors)
                        {
                            bool isSelected = ViewBag.SelectedInstructorId == inst.UserId;
                            <!option value="@inst.UserId" @(isSelected ? "selected" : "")>
                                👨‍🏫 @inst.FullName.Replace(" (Instructor)", "")
                            </!option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Search & Filter</button>
                @if (!string.IsNullOrEmpty(ViewBag.SearchKeyword) || ViewBag.SelectedInstructorId != null)
                {
                    <a asp-action="Browse" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        @if (!string.IsNullOrEmpty(course.ImageUrl))
                        {
                            <img src="@course.ImageUrl" class="card-img-top" alt="@course.CourseName" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary bg-gradient text-white d-flex align-items-center justify-content-center fw-bold fs-4 p-3 text-center" style="height: 180px;">
                                📘 @course.CourseName
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold text-dark mb-2">@course.CourseName</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(course.Description != null && course.Description.Length > 120 ? course.Description.Substring(0, 120) + "..." : course.Description)
                            </p>

                            <div class="border-top pt-2 mt-2">
                                <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
                                    <span>👨‍🏫 @(course.Instructor?.FullName?.Replace(" (Instructor)", "") ?? "Instructor")</span>
                                    <span>🧩 @(course.Modules?.Count ?? 0) Modules</span>
                                </div>

                                <form asp-action="Enroll" method="post">
                                    <input type="hidden" name="courseId" value="@course.CourseId" />
                                    <button type="submit" class="btn btn-primary w-100 fw-bold">Enroll Now</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info p-4 text-center mt-3">
            <h4>🎉 All Caught Up!</h4>
            <p class="mb-0">You have already enrolled in all available courses or no new courses are open at the moment.</p>
        </div>
    }
</div>
