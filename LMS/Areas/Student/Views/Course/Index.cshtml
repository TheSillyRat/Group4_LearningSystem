@model IEnumerable<LMS.Models.Course>

@{
    ViewData["Title"] = "My Enrolled Courses";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>🎓 My Enrolled Courses</h2>
            <p class="text-muted mb-0">Courses you are currently participating in</p>
        </div>
        <a asp-action="Browse" class="btn btn-success">+ Browse More Courses</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        @if (!string.IsNullOrEmpty(course.ImageUrl))
                        {
                            <img src="@course.ImageUrl" class="card-img-top" alt="@course.CourseName" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-dark bg-gradient text-white d-flex align-items-center justify-content-center fw-bold fs-4 p-3 text-center" style="height: 180px;">
                                📖 @course.CourseName
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-3">
                            <span class="badge bg-success w-auto align-self-start mb-2">Enrolled</span>
                            <h5 class="card-title fw-bold text-dark mb-2">@course.CourseName</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(course.Description != null && course.Description.Length > 120 ? course.Description.Substring(0, 120) + "..." : course.Description)
                            </p>

                            <div class="border-top pt-2 mt-2">
                                <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
                                    <span>👨‍🏫 @(course.Instructor?.FullName?.Replace(" (Instructor)", "") ?? "Instructor")</span>
                                </div>
                                <a asp-action="Learn" asp-route-id="@course.CourseId" class="btn btn-primary w-100 fw-bold">Go to Course 🚀</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning p-4 text-center mt-3">
            <h4>📖 No Enrolled Courses Yet</h4>
            <p class="mb-3">You haven't enrolled in any courses yet. Browse our course catalog to get started!</p>
            <a asp-action="Browse" class="btn btn-primary">Explore Courses Now</a>
        </div>
    }
</div>
