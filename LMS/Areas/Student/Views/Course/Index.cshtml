@model IEnumerable<LMS.Models.Course>

@{
    ViewData["Title"] = "Browse Courses";
}

<div class="container mt-4">
    <h2>Browse Courses</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.CourseName</h5>
                        <p class="card-text text-truncate">@item.Description</p>
                        <p class="text-muted"><small>Instructor: @item.Instructor?.FullName</small></p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <a asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-primary w-100">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
