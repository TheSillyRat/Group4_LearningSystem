@model LMS.Models.Course

@{
    ViewData["Title"] = Model.CourseName + " - Learning View";
    var selectedContent = ViewBag.SelectedContent as LMS.Models.Content;
}

<div class="container-fluid mt-3 px-4">
    <!-- TOP NAVIGATION BAR -->
    <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm mb-4 border">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">⬅️ Back to My Courses</a>
            <h4 class="mb-0 fw-bold text-dark">📘 @Model.CourseName</h4>
        </div>
        <span class="text-muted small">👨‍🏫 Instructor: <strong>@(Model.Instructor?.FullName?.Replace(" (Instructor)", "") ?? "N/A")</strong></span>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: CONTENT DISPLAY VIEWER (8 COLS) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        @(selectedContent != null ? selectedContent.Title : "No Content Selected")
                    </h5>
                    @if (selectedContent != null)
                    {
                        <span class="badge bg-warning text-dark fs-6">@selectedContent.ContentType</span>
                    }
                </div>

                <div class="card-body p-4 bg-light">
                    @if (selectedContent != null)
                    {
                        <!-- VIEWER BASED ON CONTENT TYPE -->
                        <div class="viewer-container bg-white p-3 rounded-3 border mb-3 shadow-sm text-center">
                            @if (selectedContent.ContentType == "Video" && !string.IsNullOrEmpty(selectedContent.FileUrl))
                            {
                                <video controls class="w-100 rounded-3" style="max-height: 500px;" autoplay>
                                    <source src="@selectedContent.FileUrl" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>
                            }
                            else if (selectedContent.ContentType == "PDF" && !string.IsNullOrEmpty(selectedContent.FileUrl))
                            {
                                <iframe src="@selectedContent.FileUrl" style="width: 100%; height: 550px; border: none;" class="rounded-3"></iframe>
                            }
                            else if (!string.IsNullOrEmpty(selectedContent.FileUrl))
                            {
                                <div class="p-5">
                                    <div class="fs-1 mb-3">📄</div>
                                    <h5>@selectedContent.Title</h5>
                                    <p class="text-muted">Click below to view or download this material file.</p>
                                    <a href="@selectedContent.FileUrl" target="_blank" class="btn btn-primary btn-lg">📥 Download / View File</a>
                                </div>
                            }
                            else
                            {
                                <div class="p-5 text-muted">
                                    <h5>No media file attached to this content.</h5>
                                </div>
                            }
                        </div>

                        <!-- CONTENT DESCRIPTION -->
                        <div class="bg-white p-3 rounded-3 border shadow-sm mb-3">
                            <h6 class="fw-bold text-secondary">Description:</h6>
                            <p class="mb-0">@(string.IsNullOrWhiteSpace(selectedContent.Description) ? "No description provided for this lesson." : selectedContent.Description)</p>
                        </div>

                        <!-- MY PERSONAL STUDY NOTES SECTION -->
                        <div class="bg-white p-3 rounded-3 border shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-dark mb-0">✍️ My Notes:</h6>
                                <span id="noteSavedBadge" class="badge bg-success d-none">Saved!</span>
                            </div>
                            <p class="text-muted small mb-2">Jot down key points or questions you have regarding the concepts in this lesson.</p>
                            <textarea id="personalNotesInput" class="form-control mb-2" rows="4" placeholder="Enter your personal notes here..."></textarea>
                            <div class="d-flex justify-content-end">
                                <button type="button" onclick="savePersonalNote()" class="btn btn-primary btn-sm fw-bold">💾 Save Notes</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <h4 class="text-muted">No content or lessons available in this course yet.</h4>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: COURSE SYLLABUS / TABLE OF CONTENTS (4 COLS) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-primary text-white p-3">
                    <h5 class="mb-0">📋 Course Syllabus / Modules</h5>
                </div>

                <div class="card-body p-2 bg-white" style="max-height: 680px; overflow-y: auto;">
                    @if (Model.Modules != null && Model.Modules.Any())
                    {
                        <div class="accordion" id="modulesAccordion">
                            @{
                                int mIndex = 1;
                            }
                            @foreach (var module in Model.Modules.OrderBy(m => m.DisplayOrder))
                            {
                                bool containsActiveContent = selectedContent != null && module.Contents != null && module.Contents.Any(c => c.ContentId == selectedContent.ContentId);
                                bool shouldExpand = containsActiveContent || (selectedContent == null && mIndex == 1);

                                <div class="accordion-item mb-2 border rounded-2 overflow-hidden">
                                    <h2 class="accordion-header" id="heading_@module.ModuleId">
                                        <button class="accordion-button @(shouldExpand ? "" : "collapsed") fw-bold py-2 px-3 bg-light text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@module.ModuleId" aria-expanded="@(shouldExpand ? "true" : "false")" aria-controls="collapse_@module.ModuleId">
                                            Module @module.DisplayOrder: @module.ModuleName
                                        </button>
                                    </h2>

                                    <div id="collapse_@module.ModuleId" class="accordion-collapse collapse @(shouldExpand ? "show" : "")" aria-labelledby="heading_@module.ModuleId" data-bs-parent="#modulesAccordion">
                                        <div class="accordion-body p-0">
                                            <!-- LIST OF CONTENTS IN THIS MODULE -->
                                            @if (module.Contents != null && module.Contents.Any())
                                            {
                                                <div class="list-group list-group-flush">
                                                    @foreach (var content in module.Contents.OrderBy(c => c.DisplayOrder))
                                                    {
                                                        bool isActive = selectedContent != null && selectedContent.ContentId == content.ContentId;
                                                        <a asp-action="Learn" asp-route-id="@Model.CourseId" asp-route-contentId="@content.ContentId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2.5 px-3 @(isActive ? "active bg-primary text-white" : "")">
                                                            <div class="d-flex align-items-center text-truncate">
                                                                <span class="me-2">
                                                                    @(content.ContentType == "Video" ? "🎥" : (content.ContentType == "PDF" ? "📕" : "📄"))
                                                                </span>
                                                                <span class="small fw-semibold text-truncate">@content.Title</span>
                                                            </div>
                                                            <span class="badge @(isActive ? "bg-light text-dark" : "bg-secondary") ms-2">@content.ContentType</span>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-2.5 text-muted small italic text-center">No lessons in this module.</div>
                                            }

                                            <!-- LIST OF QUIZZES IN THIS MODULE -->
                                            @if (module.Quizzes != null && module.Quizzes.Any())
                                            {
                                                <div class="border-top p-2 bg-light">
                                                    <small class="fw-bold text-primary px-2">📝 Quizzes:</small>
                                                    <ul class="list-unstyled mb-0 mt-1">
                                                        @foreach (var quiz in module.Quizzes)
                                                        {
                                                            <li class="px-2 py-1 bg-white rounded border mb-1 d-flex justify-content-between align-items-center small">
                                                                <span>📝 @quiz.QuizTitle (@quiz.Duration mins)</span>
                                                                <a asp-area="Student" asp-controller="Quiz" asp-action="Take" asp-route-id="@quiz.QuizId" class="btn btn-warning btn-xs py-0 px-2 fw-bold" style="font-size: 0.75rem;">Take Quiz</a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                mIndex++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-3 text-muted">No modules available for this course.</div>
                    }

                    <!-- GENERAL COURSE QUIZZES (BÀI THI KHOÁ HỌC TỔNG - CHƯA THUỘC MODULE NÀO) -->
                    @{
                        var courseQuizzes = Model.Quizzes?.Where(q => q.ModuleId == null).ToList();
                    }
                    @if (courseQuizzes != null && courseQuizzes.Any())
                    {
                        <div class="mt-3 border rounded-3 p-3 bg-light shadow-sm">
                            <h6 class="fw-bold text-primary mb-2">🎓 Course Final Quizzes:</h6>
                            <ul class="list-unstyled mb-0">
                                @foreach (var quiz in courseQuizzes)
                                {
                                    <li class="px-3 py-2 bg-white rounded border mb-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong class="d-block text-dark small">📝 @quiz.QuizTitle</strong>
                                            <small class="text-muted" style="font-size: 0.75rem;">⏱️ @quiz.Duration mins</small>
                                        </div>
                                        <a asp-area="Student" asp-controller="Quiz" asp-action="Take" asp-route-id="@quiz.QuizId" class="btn btn-warning btn-sm fw-bold py-1 px-2" style="font-size: 0.75rem;">Take Quiz</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const currentContentId = "@(selectedContent != null ? selectedContent.ContentId : 0)";

        document.addEventListener("DOMContentLoaded", function () {
            if (currentContentId > 0) {
                const savedNote = localStorage.getItem("my_notes_content_" + currentContentId);
                if (savedNote) {
                    const input = document.getElementById("personalNotesInput");
                    if (input) input.value = savedNote;
                }
            }
        });

        function savePersonalNote() {
            if (currentContentId > 0) {
                const input = document.getElementById("personalNotesInput");
                if (input) {
                    const noteText = input.value;
                    localStorage.setItem("my_notes_content_" + currentContentId, noteText);

                    const badge = document.getElementById("noteSavedBadge");
                    if (badge) {
                        badge.classList.remove("d-none");
                        setTimeout(() => {
                            badge.classList.add("d-none");
                        }, 2000);
                    }
                }
            }
        }
    </script>
}
