@model IEnumerable<LMS.Models.Submission>

@{
    ViewData["Title"] = "Student Submissions";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Submissions</h2>
            <p class="text-muted">@ViewBag.AssignmentTitle</p>
        </div>
        <a asp-area="Instructor" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="table-responsive bg-white rounded shadow-sm p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student Name</th>
                    <th>Submitted Date</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var sub in Model)
                    {
                        <tr>
                            <td class="fw-bold">@(sub.Student?.FullName ?? "Unknown")</td>
                            <td>@sub.SubmitDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                @if (sub.Score.HasValue)
                                {
                                    <span class="badge bg-success">Graded</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Needs Grading</span>
                                }
                            </td>
                            <td class="fw-bold text-dark">
                                @(sub.Score.HasValue ? sub.Score.Value.ToString() : "-")
                            </td>
                            <td>
                                <a asp-area="Instructor" asp-controller="Submission" asp-action="Grade" asp-route-id="@sub.SubmissionId" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                    <i class="bi bi-pencil-square"></i> Grade
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No students have submitted yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>