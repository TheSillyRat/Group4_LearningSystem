@model LMS.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4">
    <div class="card p-3 mb-4 bg-light">
        <h2>📖 @Model.CourseName</h2>
        <p><strong>Description:</strong> @Model.Description</p>
        <div>
            <a asp-action="Index" class="btn btn-secondary btn-sm">⬅️ Back to List</a>
        </div>
    </div>

    <!-- 1. QUẢN LÝ CÁC MODULE VÀ CONTENT -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3>📌 List of Modules</h3>
        <a asp-controller="Module" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-primary btn-sm">+ Add New Module</a>
    </div>

    @if (Model.Modules != null && Model.Modules.Any())
    {
        @foreach (var module in Model.Modules.OrderBy(m => m.DisplayOrder))
        {
            <div class="card mb-3 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-nowrap">
                    <h5 class="mb-0 me-2 flex-grow-1" style="word-break: break-word; min-width: 0;">Module @module.DisplayOrder: @module.ModuleName</h5>
                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                        <a asp-controller="Content" asp-action="Create" asp-route-moduleId="@module.ModuleId" class="btn btn-light btn-sm">+ Add Content</a>
                        <a asp-controller="Quiz" asp-action="Create" asp-route-courseId="@Model.CourseId" asp-route-moduleId="@module.ModuleId" class="btn btn-warning btn-sm">+ Add Quiz</a>

                        <!-- DROPDOWN MENU FOR EDIT & DELETE -->
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm dropdown-toggle text-dark d-inline-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.875rem;">
                                <i class="bi bi-gear-fill text-dark me-1" style="font-size: 0.8rem; color: #000 !important;"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><a class="dropdown-item" asp-controller="Module" asp-action="Edit" asp-route-id="@module.ModuleId">✏️ Edit Module</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Module" asp-action="Delete" asp-route-id="@module.ModuleId" onclick="return confirm('Are you sure you want to delete this module?')">🗑️ Delete Module</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                @if (module.Quizzes != null && module.Quizzes.Any())
                {
                    <div class="mt-3">
                        <strong class="text-primary">📝 Module Quizzes:</strong>
                        <ul class="list-group mt-1">
                            @foreach (var quiz in module.Quizzes)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@quiz.QuizTitle</strong> (@quiz.Duration mins)
                                    </div>
                                    <div>
                                        <a asp-controller="Quiz" asp-action="Details" asp-route-id="@quiz.QuizId" class="btn btn-outline-info btn-sm me-1">Manage Questions</a>
                                        <a asp-controller="Quiz" asp-action="Delete" asp-route-id="@quiz.QuizId" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this quiz?')">Delete</a>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="card-body">
                    <p class="text-muted">@module.Description</p>

                    <h6>📄 List of Contents:</h6>
                    @if (module.Contents != null && module.Contents.Any())
                    {
                        <ul class="list-group">
                            @foreach (var content in module.Contents)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-secondary">@content.ContentType</span>
                                        <strong>@content.Title</strong> - <small class="text-muted">@content.Description</small>
                                        @if (!string.IsNullOrEmpty(content.FileUrl))
                                        {
                                            <a href="@content.FileUrl" target="_blank" class="ms-2 text-decoration-none">📥 View/Download File</a>
                                        }
                                    </div>
                                    <div>
                                        <a asp-controller="Content" asp-action="Edit" asp-route-id="@content.ContentId" class="btn btn-outline-warning btn-sm me-1">Edit</a>
                                        <a asp-controller="Content" asp-action="Delete" asp-route-id="@content.ContentId" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this content?')">Delete</a>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted italic small">No lessons or learning materials are available in this section yet.</p>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No modules have been created yet.</div>
    }

    <hr class="my-4" />

    <!-- 2. QUẢN LÝ QUIZ (BÀI KIỂM TRA) -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3>📝 List of Quizzes</h3>
        <a asp-controller="Quiz" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-warning btn-sm">+ Create New Quiz</a>
    </div>

    @if (Model.Quizzes != null && Model.Quizzes.Any())
    {
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Quiz Title</th>
                    <th>Belongs To</th>
                    <th>Duration</th>
                    <th width="220px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quiz in Model.Quizzes)
                {
                    <tr>
                        <td class="fw-bold">@quiz.QuizTitle</td>
                        <td>
                            @if (quiz.ModuleId.HasValue && quiz.Module != null)
                            {
                                <span class="badge bg-info text-dark">🧩 Module: @quiz.Module.ModuleName</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">🎓 General Course Quiz</span>
                            }
                        </td>
                        <td>@quiz.Duration minutes</td>
                        <td>
                            <a asp-controller="Quiz" asp-action="Details" asp-route-id="@quiz.QuizId" class="btn btn-info btn-sm me-1">Questions Manager</a>
                            <a asp-controller="Quiz" asp-action="Delete" asp-route-id="@quiz.QuizId" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this quiz?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning">No quizzes available for this course.</div>
    }
</div>