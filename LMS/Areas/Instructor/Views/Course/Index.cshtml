@model IEnumerable<LMS.Models.Course>

@{
    ViewData["Title"] = "Course Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📚 Course List</h2>
        <a asp-action="Create" class="btn btn-success">+ Create New Course</a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th width="100px">Image</th>
                <th>Course Name</th>
                <th>Description</th>
                <th width="220px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CourseId</td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.CourseName" style="width: 70px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd;" />
                        }
                        else
                        {
                            <span class="text-muted small">No Image</span>
                        }
                    </td>
                    <td class="fw-bold">@item.CourseName</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.CourseId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>