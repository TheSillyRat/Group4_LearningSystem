@model LMS.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>✏ Edit Course</h2>
    <hr />
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="InstructorId" />

        <div class="mb-3">
            <label class="form-label">Course Name (*)</label>
            <input asp-for="CourseName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Course Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <input type="hidden" asp-for="ImageUrl" />

        <div class="mb-3">
            <label class="form-label">Image Course (Max 5MB)</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ImageUrl" style="max-height: 120px; border-radius: 8px;" alt="Course Image" />
                </div>
            }
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Update</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>