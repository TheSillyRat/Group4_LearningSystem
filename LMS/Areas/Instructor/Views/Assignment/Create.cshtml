@{
    ViewData["Title"] = "Create Assignment";
}

<div class="assignment-page">

    <div class="assignment-card">

        <!-- Header -->
        <div class="assignment-header">
            <h1>Create Assignment</h1>
            <p>Create a new assignment for your course</p>
        </div>

        <form asp-action="Create"
              asp-controller="Assignment"
              method="post"
              enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
            <!-- Title + Course -->
            <div class="form-row">

                <div class="form-group">
                    <label for="AssignmentTitle">Assignment Title</label>
                    <input type="text"
                           id="AssignmentTitle"
                           name="AssignmentTitle"
                           class="form-control"
                           placeholder="Enter assignment title" />
                </div>

                <div class="form-group">
                    <label for="CourseId">Course</label>

                    <select id="CourseId"
                            name="CourseId"
                            class="form-control"
                            required>

                        <option value="">Select course</option>

                        @if (ViewBag.Courses != null)
                        {
                            foreach (var course in (IEnumerable<LMS.Models.Course>)ViewBag.Courses)
                            {
                                <option value="@course.CourseId">@course.CourseName</option>
                            }
                        }

                    </select>
                </div>

            </div>


            <!-- Module + Due Date -->
            <div class="form-row">

                <div class="form-group">
                    <label for="ModuleId">Module / Section</label>

                    <select id="ModuleId"
                            name="ModuleId"
                            class="form-control">

                        <option value="">Select module</option>

                        @if (ViewBag.Modules != null)
                        {
                            foreach (var module in (IEnumerable<LMS.Models.Module>)ViewBag.Modules)
                            {
                                <option value="@module.ModuleId">@module.ModuleName</option>
                            }
                        }

                    </select>
                </div>

                <div class="form-group">
                    <label for="DueDate">Due Date</label>

                    <input type="datetime-local"
                           id="DueDate"
                           name="DueDate"
                           class="form-control" />
                </div>

            </div>


            <!-- Description -->
            <div class="form-group full-width">

                <label for="Description">
                    Description / Instructions
                </label>

                <textarea id="Description"
                          name="Description"
                          class="form-control assignment-description"
                          placeholder="Write instructions for students..."></textarea>

            </div>


            <!-- Maximum Score + Attachment -->
            <div class="form-row">

                <div class="form-group">

                    <label for="MaxScore">
                        Maximum Score
                    </label>

                    <input type="number"
                           id="MaxScore"
                           name="MaxScore"
                           class="form-control"
                           value="100"
                           min="0" />

                </div>


                <div class="form-group">

                    <label for="Attachment">
                        Attachment
                    </label>

                    <div class="file-upload">

                        <label for="Attachment"
                               class="file-upload-button">

                            <i class="bi bi-paperclip"></i>
                            Add File

                        </label>

                        <input type="file"
                               id="Attachment"
                               name="Attachment"
                               hidden />

                    </div>

                </div>

            </div>


            <!-- Options -->
            <div class="form-group options-group">

                <label>Options</label>

                <div class="assignment-options">

                    <label class="checkbox-option">

                        <input type="checkbox"
                               name="PublishImmediately"
                               value="true" />

                        <span>Publish immediately</span>

                    </label>

                </div>

            </div>


            <!-- Buttons -->
            <input type="hidden" name="InstructorId" value="1" />
            <div class="form-actions">

                <button type="submit"
                        class="btn-create">
                    Create Assignment
                </button>

                <a asp-action="Index"
                   class="btn-cancel">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('CourseId').addEventListener('change', function() {
            var courseId = this.value;
            var moduleSelect = document.getElementById('ModuleId');

            // Xóa sạch các option Module hiện tại
            moduleSelect.innerHTML = '<option value="">Select module</option>';

            if (courseId) {
                // Gọi API lấy danh sách Module thuộc Course được chọn
                fetch('/Instructor/Assignment/GetModulesByCourse?courseId=' + courseId)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(item => {
                            var option = document.createElement('option');
                            option.value = item.id;
                            option.textContent = item.name;
                            moduleSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Lỗi lấy danh sách Module:', error));
            }
        });
    </script>
}