@model IEnumerable<LMS.Models.Assignment>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Assignment Management</h2>
        <a href="/Instructor/Assignment/Create" class="btn btn-primary">Create New Assignment</a>
    </div>

    <table class="table table-bordered table-hover bg-white">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Course ID</th>
                <th>Due Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AssignmentId</td>
                    <td>@item.AssignmentTitle</td>
                    <td>@item.CourseId</td>
                    <td>@item.DueDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a href="/Instructor/Assignment/Details/@item.AssignmentId" class="btn btn-sm btn-info text-white">View & Grade</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>