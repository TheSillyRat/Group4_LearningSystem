@model LMS.Models.Content

@{
    ViewData["Title"] = "Upload Content";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>📤 Upload Content</h2>
    <hr />
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ModuleId" value="@ViewBag.ModuleId" />

        <div class="mb-3">
            <label class="form-label">Title (*)</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Content Type (*)</label>
            <select asp-for="ContentType" class="form-select">
                <option value="PDF">PDF</option>
                <option value="Slide">Slide (PPTX)</option>
                <option value="Video">Video Link/File</option>
                <option value="Document">Word Doc</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Paste Video/External Link (URL)</label>
            <input asp-for="FileUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
        </div>

        <div class="text-center fw-bold text-muted my-2">Or</div>

        <div class="mb-3">
            <label class="form-label">Choose File to Upload (PDF, Slide...)</label>
            <input type="file" name="fileUpload" class="form-control" />

        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Display Order</label>
            <input asp-for="DisplayOrder" type="number" class="form-control" value="1" />
        </div>

        <button type="submit" class="btn btn-success">Upload & Save</button>
    </form>
</div>