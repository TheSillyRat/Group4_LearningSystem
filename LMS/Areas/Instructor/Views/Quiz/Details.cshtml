@model LMS.Models.Quiz

@{
    ViewData["Title"] = "Manage Quiz Questions";
}

<div class="container mt-4">
    <!-- QUIZ HEADER INFORMATION -->
    <div class="card p-3 mb-4 bg-light">
        <h2>📝 @Model.QuizTitle</h2>
        <p>
            <strong>Duration:</strong> @Model.Duration mins | 
            <strong>Course:</strong> @(Model.Course?.CourseName ?? "N/A")
            @if (Model.Module != null)
            {
                <span> | <strong>Module:</strong> @Model.Module.ModuleName</span>
            }
        </p>
        <p>@Model.Description</p>
        <div>
            <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-secondary btn-sm">⬅️ Back to Course</a>
        </div>
    </div>

    <div class="row">
        <!-- LEFT COLUMN: ADD QUESTION FORM -->
        <div class="col-md-5">
            <div class="card p-3 border-primary">
                <h4>➕ Add New Question</h4>
                <hr />
                <form asp-action="AddQuestion" method="post" id="questionForm">
                    <input type="hidden" name="QuizId" value="@Model.QuizId" />
                    <input type="hidden" name="CorrectAnswer" id="finalCorrectAnswer" />

                    <div class="mb-3">
                        <label class="form-label">Question Type (*)</label>
                        <select name="QuestionType" id="questionTypeSelect" class="form-select" onchange="toggleQuestionFields()">
                            <option value="SingleChoice">Single Choice</option>
                            <option value="MultipleChoice">Multiple Choice</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Question Text (*)</label>
                        <textarea name="QuestionText" class="form-control" rows="3" required placeholder="Enter question content here..."></textarea>
                    </div>

                    <!-- OPTIONS A, B, C, D SECTION -->
                    <div id="optionsSection">
                        <div class="mb-2">
                            <label class="form-label">Option A</label>
                            <input name="OptionA" class="form-control" placeholder="Option A" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Option B</label>
                            <input name="OptionB" class="form-control" placeholder="Option B" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Option C</label>
                            <input name="OptionC" class="form-control" placeholder="Option C" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Option D</label>
                            <input name="OptionD" class="form-control" placeholder="Option D" />
                        </div>

                        <!-- 1. CORRECT ANSWER (SINGLE CHOICE) -->
                        <div class="mb-3" id="singleAnswerSection">
                            <label class="form-label">Correct Answer (*)</label>
                            <select id="singleCorrectAnswerSelect" class="form-select">
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>

                        <!-- 2. MULTIPLE CORRECT ANSWERS (MULTIPLE CHOICE) -->
                        <div class="mb-3" id="multipleAnswersSection" style="display:none;">
                            <label class="form-label">Correct Answers (*) <small class="text-muted">(Check all that apply)</small></label>
                            <div class="d-flex gap-3 mt-1">
                                <div class="form-check">
                                    <input class="form-check-input multi-check" type="checkbox" value="A" id="chkA">
                                    <label class="form-check-label" for="chkA">Option A</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input multi-check" type="checkbox" value="B" id="chkB">
                                    <label class="form-check-label" for="chkB">Option B</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input multi-check" type="checkbox" value="C" id="chkC">
                                    <label class="form-check-label" for="chkC">Option C</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input multi-check" type="checkbox" value="D" id="chkD">
                                    <label class="form-check-label" for="chkD">Option D</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Save Question</button>
                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN: QUESTION LIST -->
        <div class="col-md-7">
            <h4>📋 Question List (@(Model.Questions?.Count ?? 0) questions)</h4>
            <hr />
            @if (Model.Questions != null && Model.Questions.Any())
            {
                int index = 1;
                foreach (var q in Model.Questions)
                {
                    <div class="card mb-3 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 text-primary">Question @index: @q.QuestionText</h6>
                            <span class="badge @(q.QuestionType == "MultipleChoice" ? "bg-success" : "bg-info")">
                                @(q.QuestionType == "MultipleChoice" ? "Multiple Choice" : "Single Choice")
                            </span>
                        </div>

                        <ul class="small mb-2">
                            <li>A. @q.OptionA</li>
                            <li>B. @q.OptionB</li>
                            <li>C. @q.OptionC</li>
                            <li>D. @q.OptionD</li>
                        </ul>
                        <p class="text-success small fw-bold mb-1">Correct Answer(s): @q.CorrectAnswer</p>

                        <div class="text-end mt-2">
                            <a asp-action="DeleteQuestion" asp-route-id="@q.QuestionId" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this question?')">Delete</a>
                        </div>
                    </div>
                    index++;
                }
            }
            else
            {
                <div class="alert alert-info">No questions added to this quiz yet.</div>
            }
        </div>
    </div>
</div>

<script>
    function toggleQuestionFields() {
        var type = document.getElementById('questionTypeSelect').value;
        var optionsSection = document.getElementById('optionsSection');
        var singleAnswerSection = document.getElementById('singleAnswerSection');
        var multipleAnswersSection = document.getElementById('multipleAnswersSection');

        if (type === 'SingleChoice') {
            optionsSection.style.display = 'block';
            singleAnswerSection.style.display = 'block';
            multipleAnswersSection.style.display = 'none';
        } else if (type === 'MultipleChoice') {
            optionsSection.style.display = 'block';
            singleAnswerSection.style.display = 'none';
            multipleAnswersSection.style.display = 'block';
        }
    }

    document.getElementById('questionForm').addEventListener('submit', function(e) {
        var type = document.getElementById('questionTypeSelect').value;
        var finalAnsInput = document.getElementById('finalCorrectAnswer');

        if (type === 'SingleChoice') {
            finalAnsInput.value = document.getElementById('singleCorrectAnswerSelect').value;
        } else if (type === 'MultipleChoice') {
            var selectedCheckboxes = document.querySelectorAll('.multi-check:checked');
            var selectedValues = Array.from(selectedCheckboxes).map(cb => cb.value);
            if (selectedValues.length === 0) {
                alert('Please select at least one correct answer for Multiple Choice question!');
                e.preventDefault();
                return false;
            }
            finalAnsInput.value = selectedValues.join(', ');
        }
    });
</script>