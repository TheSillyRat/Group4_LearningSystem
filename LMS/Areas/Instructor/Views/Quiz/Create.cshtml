@model LMS.Models.Quiz

@{
    ViewData["Title"] = "Create Quiz";
    var modules = ViewBag.Modules as List<LMS.Models.Module>;
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>📝 Create New Quiz</h2>
    <hr />
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="CourseId" />

        <div class="mb-3">
            <label class="form-label">Quiz Title (*)</label>
            <input asp-for="QuizTitle" class="form-control" required placeholder="e.g. Module 1 Knowledge Check" />
        </div>

        <div class="mb-3">
            <label class="form-label">Belongs to Module (Optional)</label>
            <select asp-for="ModuleId" class="form-select">
                <option value="">-- General Course Quiz (No Specific Module) --</option>
                @if (modules != null)
                {
                    foreach (var m in modules)
                    {
                        <option value="@m.ModuleId">@m.ModuleName</option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>


        <div class="mb-3">
            <label class="form-label">Duration (Minutes)</label>
            <input asp-for="Duration" type="number" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Create Quiz</button>
    </form>
</div>