@model LMS.Models.Module

@{
    ViewData["Title"] = "Create Module";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>📌 Create New Module</h2>
    <hr />
    <form asp-action="Create" method="post">
        <!-- Ẩn CourseId để gán module vào đúng khóa học -->
        <input type="hidden" asp-for="CourseId" value="@ViewBag.CourseId" />

        <div class="mb-3">
            <label class="form-label">Module Name (*)</label>
            <input asp-for="ModuleName" class="form-control" placeholder="Example: Overview..." required />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Display Order (*)</label>
            <input asp-for="DisplayOrder" type="number" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Save Module</button>
        <a asp-controller="Course" asp-action="Details" asp-route-id="@ViewBag.CourseId" class="btn btn-secondary">Cancel</a>
    </form>
</div>