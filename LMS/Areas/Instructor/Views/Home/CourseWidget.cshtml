@model IEnumerable<LMS.Models.Course>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var course in Model)
        {
            <div class="col-md-6 col-xl-6 mb-4">
                <div class="col h-100">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        @if (!string.IsNullOrEmpty(course.ImageUrl))
                        {
                            <img src="@course.ImageUrl" class="card-img-top" alt="@course.CourseName" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-dark bg-gradient text-white d-flex align-items-center justify-content-center fw-bold fs-4 p-3 text-center" style="height: 180px;">
                                📖 @course.CourseName
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold text-dark mb-2 mt-2">@course.CourseName</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(course.Description != null && course.Description.Length > 120 ? course.Description.Substring(0, 120) + "..." : course.Description)
                            </p>

                            <div class="border-top pt-3 mt-3">
                                <a asp-area="Instructor" asp-controller="Course" asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-outline-primary w-100 fw-bold">
                                    <i class="bi bi-gear"></i> Manage Course
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted p-5 bg-light rounded-3">
            <i class="bi bi-journal-x fs-1 mb-3 d-block"></i>
            <p>You haven't created any courses yet.</p>
            <a href="/Instructor/Course/Create" class="btn btn-primary mt-2">Create New Course</a>
        </div>
    }
</div>