@model LMS.ViewModels.Layout.SidebarViewModel

<aside class="sidebar">

    <!-- User information -->
    <div class="sidebar-user">

        <div class="sidebar-avatar">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="Avatar" />
            }
            else
            {
                <div class="default-avatar">
                    @(!string.IsNullOrEmpty(Model.DisplayName) ? Model.DisplayName.Substring(0, 1).ToUpper() : "U")
                </div>
            }
        </div>

        <div class="sidebar-user-info">
            <div class="sidebar-name">
                @Model.DisplayName
            </div>

            <div class="sidebar-email">
                @Model.Email
            </div>

            <div class="sidebar-role">
                @Model.RoleName
            </div>
        </div>

    </div>


    <!-- Navigation -->
    <nav class="sidebar-navigation">

        @foreach (var item in Model.Items)
        {
            <div class="sidebar-item">

                @if (item.Children.Any())
                {
                   
                    <button type="button"
                            class="sidebar-link sidebar-parent"
                            data-sidebar-toggle>

                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <i class="@item.Icon"></i>
                        }

                        <span>@item.Title</span>

                        <i class="bi bi-chevron-down sidebar-arrow"></i>

                    </button>

                    <div class="sidebar-submenu">

                        @foreach (var child in item.Children)
                        {
                            <a href="@child.Url"
                               class="sidebar-sublink @(child.IsActive ? "active" : "")">

                                <span>@child.Title</span>

                                @if (!string.IsNullOrEmpty(child.Badge))
                                {
                                    <span class="sidebar-badge">
                                        @child.Badge
                                    </span>
                                }

                            </a>
                        }

                    </div>
                }
                else
                {
                    
                    <a href="@item.Url"
                       class="sidebar-link @(item.IsActive ? "active" : "")">

                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <i class="@item.Icon"></i>
                        }

                        <span>@item.Title</span>

                        @if (!string.IsNullOrEmpty(item.Badge))
                        {
                            <span class="sidebar-badge">
                                @item.Badge
                            </span>
                        }

                    </a>
                }

            </div>
        }

    </nav>

    <!-- Logout Button -->
    <div class="sidebar-logout p-3 border-top border-secondary border-opacity-25 mt-auto">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="w-100">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 rounded-3 py-2 fw-medium shadow-sm">
                <i class="bi bi-box-arrow-right fs-5"></i>
                <span>Log Out</span>
            </button>
        </form>
    </div>

</aside>