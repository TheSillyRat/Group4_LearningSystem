@inject LMS.Services.Layout.SidebarService SidebarService
@using System.Security.Claims

@{
    var roleName = User.FindFirstValue(ClaimTypes.Role) ?? "Student";
    var userName = User.FindFirstValue(ClaimTypes.Name) ?? User.Identity?.Name ?? "User";
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";

    var sidebar = SidebarService.GetSidebar(roleName);
    sidebar.DisplayName = userName;
    sidebar.Email = userEmail;
                        Url = "/Student/Enrollment/MyCourses"
                    },

                    new()
                    {
                        Title = "Course Materials",
                        Url = "#"
                    }
                }
            },

            new()
            {
                Title = "Assignments",
                Icon = "bi bi-file-earmark-text",

                Children =
                {
                    new()
                    {
                        Title = "My Assignments",
                        Url = "#"
                    },

                    new()
                    {
                        Title = "My Submissions",
                        Url = "#"
                    }
                }
            },

            new()
            {
                Title = "Assessments",
                Icon = "bi bi-patch-question",

                Children =
                {
                    new()
                    {
                        Title = "Quizzes",
                        Url = "#"
                    },

                    new()
                    {
                        Title = "Exams",
                        Url = "#"
                    }
                }
            },

            new()
            {
                Title = "Grades",
                Icon = "bi bi-bar-chart",
                Url = "#"
            },

            new()
            {
                Title = "Discussion",
                Icon = "bi bi-chat-dots",
                Url = "#"
            },

            new()
            {
                Title = "Profile",
                Icon = "bi bi-person",
                Url = "#"
            }
        }
    };
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LMS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ==================== MAIN LAYOUT ==================== -->
    <div class="layout-container">

        <!-- SIDEBAR -->
        @await Html.PartialAsync("_Sidebar", sidebar)


        <!-- PAGE CONTENT -->
        <main class="main-content">

            @RenderBody()

        </main>

    </div>


    <!-- ==================== SCRIPTS ==================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/sidebar.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>